{
  "manifest_version": 3,
  "name": "MediaGrab fetcher",
  "version": "1.0.0",
  "description": "Find every video on the current page (previews, sizes, quality) and download them with MediaGrab — segmented, resumable, optimal-speed downloads.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaGrab fetcher"
  },
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
