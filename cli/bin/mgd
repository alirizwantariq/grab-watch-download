#!/usr/bin/env python3
"""mgd launcher - run from anywhere: bin/mgd ..."""
import os
import pathlib
import sys

HERE = pathlib.Path(__file__).resolve()
if ".app/Contents/Resources/" in str(HERE):
    # running from inside MediaGrab.app: keep Python's bytecode cache out of
    # the code-signed bundle (writing there would break its seal)
    sys.pycache_prefix = os.path.join(
        os.path.expanduser("~/Library/Caches"), "MediaGrab", "pycache")
sys.path.insert(0, str(HERE.parent.parent))

from mgd.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
